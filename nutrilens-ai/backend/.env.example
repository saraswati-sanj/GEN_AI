# ─────────────────────────────────────────────
#  NutriLens AI — Environment Configuration
# ─────────────────────────────────────────────

# ── Google Gemini ──────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── PostgreSQL ─────────────────────────────────
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nutrilens
POSTGRES_PASSWORD=nutrilens_password
POSTGRES_DB=nutrilens_db
DATABASE_URL=postgresql+asyncpg://nutrilens:nutrilens_password@localhost:5432/nutrilens_db

# ── Security ───────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Embedding Model ────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── ChromaDB ───────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=nutrilens_knowledge

# ── OpenFoodFacts ──────────────────────────────
OFF_USER_AGENT=NutriLensAI/1.0 (contact@nutrilens.ai)

# ── App ────────────────────────────────────────
APP_NAME=NutriLens AI
APP_VERSION=1.0.0
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
